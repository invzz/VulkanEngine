# yaml-language-server: $schema=https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/clangd.json

# Clangd project configuration
# - Uses the compilation database generated into ./.vscode
# - Keeps diagnostics focused on project code (src/ + include/)
# - clang-tidy checks are configured in ./.clang-tidy

CompileFlags:
  CompilationDatabase: .vscode

Index:
  Background: Build

Diagnostics:
  # Don't override checks here; .clang-tidy already defines them
  # (including HeaderFilterRegex to keep diagnostics focused on src/include).
  # Whether clang-tidy runs inside clangd depends on how clangd is launched
  # (e.g., VS Code clangd extension often passes --clang-tidy).
  ClangTidy:
    Add: []
    Remove: []

InlayHints:
  Enabled: true

Hover:
  ShowAKA: true
