{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "explorer.sortOrder": "type",
    "clang-format.style": "file",
    "clangd.arguments": ["--clang-tidy"],
    // Semantic token colors (clangd)
    // Enable semantic highlighting
    "editor.semanticHighlighting.enabled": true,

    // Semantic token colors
    "editor.semanticTokenColorCustomizations": {
      "enabled": true,
      "rules": {
        // Types & Declarations
        "type": "#4EC9B0",
        "class": "#4EC9B0",
        "struct": "#4EC9B0",
        "interface": "#4EC9B0",
        "enum": "#B8D7A3",
        "enumMember": "#B8D7A3",
        "namespace": "#C586C0",
        "templateParameter": "#4EC9B0",
        "typeParameter": "#4EC9B0",

        // Functions & Methods
        "function": "#DCDCAA",
        "method": "#DCDCAA",
        "property": "#00CED1", // default property color
        "macro": "#C586C0",

        // Variables
        "variable": "#9CDCFE", // local variables
        "parameter": "#569CD6",
        "label": "#C586C0",

        // Object member access
        "variable.other.object.access.cpp": "#FFD700", // gold
        "variable.other.property.cpp": "#00CED1", // turquoise

        // Constants & Literals
        "constant": "#4FC1FF",
        "boolean": "#569CD6",
        "number": "#B5CEA8",
        "string": "#CE9178",
        "character": "#CE9178",
        "regexp": "#D16969",

        // Keywords & Operators
        "keyword": "#C586C0",
        "operator": "#D4D4D4",

        // Comments
        "comment": "#6A9955",

        // Invalid / Errors
        "invalid": "#F44747"
      }
    },

    // TextMate rules for things semantic tokens miss
    "editor.tokenColorCustomizations": {
      "textMateRules": [
        // Control keywords
        {
          "scope": [
            "keyword.control.return.cpp",
            "keyword.control.break.cpp",
            "keyword.control.continue.cpp",
            "keyword.control.if.cpp",
            "keyword.control.else.cpp",
            "keyword.control.switch.cpp",
            "keyword.control.case.cpp",
            "keyword.control.default.cpp",
            "keyword.control.for.cpp",
            "keyword.control.while.cpp",
            "keyword.control.do.cpp",
            "keyword.control.goto.cpp"
          ],
          "settings": {
            "foreground": "#D8A0DF",
            "fontStyle": "bold"
          }
        },
        // Other keywords
        {
          "scope": ["keyword.other.cpp", "keyword.operator.cpp"],
          "settings": {
            "foreground": "#C586C0"
          }
        },
        // Comments
        {
          "scope": [
            "comment.line.cpp",
            "comment.block.cpp",
            "comment.documentation.cpp"
          ],
          "settings": {
            "foreground": "#6A9955",
            "fontStyle": "italic"
          }
        },
        // Strings
        {
          "scope": [
            "string.quoted.double.cpp",
            "string.quoted.single.cpp",
            "string.quoted.other.cpp"
          ],
          "settings": {
            "foreground": "#CE9178"
          }
        },
        // Numbers
        {
          "scope": ["constant.numeric.cpp"],
          "settings": {
            "foreground": "#B5CEA8"
          }
        },
        // Functions
        {
          "scope": ["entity.name.function.cpp", "support.function.cpp"],
          "settings": {
            "foreground": "#DCDCAA"
          }
        },
        // Local variables
        {
          "scope": ["variable.other.cpp"],
          "settings": {
            "foreground": "#9CDCFE"
          }
        },
        // Object members
        {
          "scope": ["variable.other.object.access.cpp"],
          "settings": {
            "foreground": "#FFD700"
          }
        },
        // Properties
        {
          "scope": ["variable.other.property.cpp"],
          "settings": {
            "foreground": "#00CED1"
          }
        },
        // Types & classes
        {
          "scope": [
            "entity.name.type.cpp",
            "entity.name.class.cpp",
            "entity.name.struct.cpp",
            "entity.name.enum.cpp",
            "entity.name.namespace.cpp"
          ],
          "settings": {
            "foreground": "#4EC9B0"
          }
        }
      ]
    },
    "files.associations": {
      "*.task": "glsl",
      "*.vert": "glsl",
      "*.frag": "glsl",
      "*.geom": "glsl",
      "*.comp": "glsl",
      "*.mesh": "glsl"
    },
    "makefile.configureOnOpen": false
  },
 
}
