#version 450

layout(local_size_x = 16, local_size_y = 16) in;

struct TriG
{
  vec3 p0;
  vec3 p1;
  vec3 p2;
  vec3 n0;
  vec3 n1;
  vec3 n2;
  vec2 uv0;
  vec2 uv1;
  vec2 uv2;
};

struct NodeG
{
  vec4  minv; // min.xyz
  vec4  maxv; // max.xyz
  ivec4 meta; // left, right, start, count
};

layout(std430, binding = 0) readonly buffer Triangles
{
  TriG tris[];
};

layout(std430, binding = 1) readonly buffer TriIndexPerTexel
{
  int triIndexPerTexel[];
};

layout(std430, binding = 2) readonly buffer TexelRanges
{
  ivec2 texelRange[]; // start, count per texel
};

layout(std430, binding = 3) readonly buffer BVHNodes
{
  NodeG nodes[];
};

layout(std430, binding = 4) buffer Counts
{
  uint counts[];
};

layout(std430, binding = 5) readonly buffer TriIndexGlobal
{
  int triIndexGlobal[]; // flattened global tri indices used by BVH leaves
};

layout(push_constant) uniform Params // max 128 bytes %16
{
  int   imageWidth;
  int   imageHeight;
  int   samples;
  float eps;
  vec3  sunDir;
  float sunIntensity;
}
params;

// simple hash-based rng
uint wang_hash(uint seed)
{
  seed = (seed ^ 61u) ^ (seed >> 16);
  seed *= 9u;
  seed = seed ^ (seed >> 4);
  seed *= 0x27d4eb2du;
  seed = seed ^ (seed >> 15);
  return seed;
}

float randf(inout uint state)
{
  state = wang_hash(state);
  return float(state) * (1.0 / 4294967296.0);
}

bool intersectAABB(vec3 orig, vec3 invDir, bvec3 sign, vec3 bmin, vec3 bmax, float tmin, float tmax)
{
  for (int i = 0; i < 3; ++i)
  {
    float t1 = ((sign[i] ? bmax[i] : bmin[i]) - orig[i]) * invDir[i];
    float t2 = ((sign[i] ? bmin[i] : bmax[i]) - orig[i]) * invDir[i];
    tmin     = max(tmin, min(t1, t2));
    tmax     = min(tmax, max(t1, t2));
    if (tmax < tmin) return false;
  }
  return true;
}

bool intersectTri(vec3 orig, vec3 dir, TriG t, out float tOut)
{
  vec3  e1 = t.p1 - t.p0;
  vec3  e2 = t.p2 - t.p0;
  vec3  h  = cross(dir, e2);
  float a  = dot(e1, h);
  if (abs(a) < 1e-9) return false;
  float f = 1.0 / a;
  vec3  s = orig - t.p0;
  float u = f * dot(s, h);
  if (u < 0.0 || u > 1.0) return false;
  vec3  q = cross(s, e1);
  float v = f * dot(dir, q);
  if (v < 0.0 || u + v > 1.0) return false;
  float tval = f * dot(e2, q);
  if (tval > 0.0)
  {
    tOut = tval;
    return true;
  }
  return false;
}

void main()
{
  uint gx  = gl_GlobalInvocationID.x;
  uint gy  = gl_GlobalInvocationID.y;
  uint idx = gy * uint(params.imageWidth) + gx;
  if (gx >= uint(params.imageWidth) || gy >= uint(params.imageHeight)) return;

  ivec2 range = texelRange[int(idx)];
  int   start = range.x;
  int   count = range.y;
  if (count <= 0)
  {
    counts[idx] = 0u;
    return;
  }

  uint rng  = uint(idx) * 73856093u + 19349663u;
  int  hits = 0;

  for (int s = 0; s < params.samples; ++s)
  {
    float rx = (float(gx) + randf(rng));
    float ry = (float(gy) + randf(rng));

    // find triangle that covers sample
    bool hitTri = false;
    vec3 samplePos;
    vec3 sampleN;
    for (int ti = 0; ti < count; ++ti)
    {
      int  triIndex = triIndexPerTexel[start + ti];
      TriG t        = tris[triIndex];
      vec2 uv0      = t.uv0 * vec2(float(params.imageWidth - 1), float(params.imageHeight - 1));
      vec2 uv1      = t.uv1 * vec2(float(params.imageWidth - 1), float(params.imageHeight - 1));
      vec2 uv2      = t.uv2 * vec2(float(params.imageWidth - 1), float(params.imageHeight - 1));

      vec2  v0  = uv1 - uv0;
      vec2  v1  = uv2 - uv0;
      vec2  v2  = vec2(rx, ry) - uv0;
      float den = v0.x * v1.y - v0.y * v1.x;
      if (abs(den) < 1e-12) continue;
      float invDen = 1.0 / den;
      float a      = (v2.x * v1.y - v2.y * v1.x) * invDen;
      float b      = (v0.x * v2.y - v0.y * v2.x) * invDen;
      float c      = 1.0 - a - b;
      if (a >= -1e-6 && b >= -1e-6 && c >= -1e-6)
      {
        samplePos = a * t.p1 + b * t.p2 + c * t.p0;
        sampleN   = normalize(a * t.n1 + b * t.n2 + c * t.n0);
        hitTri    = true;
        break;
      }
    }
    if (!hitTri) continue;

    // ray toward sun
    vec3  dir    = -params.sunDir;
    vec3  orig   = samplePos + sampleN * params.eps;
    vec3  invDir = 1.0 / dir;
    bvec3 sign   = bvec3(invDir.x < 0.0, invDir.y < 0.0, invDir.z < 0.0);

    // BVH traversal stack
    int stack[64];
    int sp        = 0;
    stack[sp++]   = 0;
    bool occluded = false;
    while (sp > 0)
    {
      int   n  = stack[--sp];
      NodeG nd = nodes[n];
      if (!intersectAABB(orig, invDir, sign, nd.minv.xyz, nd.maxv.xyz, params.eps, 1e20)) continue;
      int left     = nd.meta.x;
      int right    = nd.meta.y;
      int startIdx = nd.meta.z;
      int cnt      = nd.meta.w;
      if (left == -1 && right == -1)
      {
        for (int ti = 0; ti < cnt; ++ti)
        {
          int   triId = int(triIndexGlobal[startIdx + ti]);
          TriG  tri   = tris[triId];
          float tHit;
          if (intersectTri(orig, dir, tri, tHit))
          {
            occluded = true;
            break;
          }
        }
      }
      else
      {
        if (right != -1) stack[sp++] = right;
        if (left != -1) stack[sp++] = left;
      }
      if (occluded) break;
    }

    if (!occluded) hits++;
  }

  counts[idx] = uint(hits);
}
